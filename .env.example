# Configuração local / desenvolvimento
BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Em desenvolvimento (sem Docker), deixe DATABASE_URL vazio para usar SQLite.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/price_bot
# POSTGRES_URL=postgresql://postgres:postgres@db:5432/price_bot
DATABASE_PATH=./data/price_bot.db
CHECK_INTERVAL_MINUTES=30
API_PORT=8000
LOG_LEVEL=INFO
APP_ENV=development

# Em produção, configure estas variáveis no provedor externo.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# APP_ENV=production

# Worker: retenção do histórico (dias) e pausa entre coletas (segundos)
PRICE_RETENTION_DAYS=90
REQUEST_DELAY_SECONDS=1
