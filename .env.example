# Configuração local / desenvolvimento
# Em desenvolvimento (sem Docker), deixe DATABASE_URL vazio para usar SQLite.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/price_bot
# POSTGRES_URL=postgresql://postgres:postgres@db:5432/price_bot
DATABASE_PATH=./data/price_bot.db
CHECK_INTERVAL_MINUTES=30
API_PORT=8000
LOG_LEVEL=INFO
APP_ENV=development

# Em produção, configure estas variáveis no provedor externo.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# APP_ENV=production

# Worker: retenção do histórico (dias) e pausa entre coletas (segundos)
PRICE_RETENTION_DAYS=90
REQUEST_DELAY_SECONDS=1

# E-mail de alertas (SMTP). Sem SMTP_HOST, alertas ficam apenas no log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASSWORD=senha-de-app-do-gmail
# ALERT_EMAIL_FROM=seuemail@gmail.com
# ALERT_EMAIL_TO=destinatario@email.com

# Segurança do dashboard (rotas de escrita). Sem ADMIN_PASSWORD, rotas abertas.
# ADMIN_PASSWORD=uma-senha-forte

# Cron do worker serverless (vercel.json dispara /cron/monitor periodicamente).
# Sem CRON_SECRET, o endpoint fica aberto (só use assim em desenvolvimento).
# CRON_SECRET=um-token-aleatorio-longo

# Rate limit do cadastro por IP (padrão: 10 por minuto) — agora persistido no
# banco, funcionando corretamente em serverless.
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60
