APP_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/pricebot
CHECK_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
PRICE_RETENTION_DAYS=90
REQUEST_DELAY_SECONDS=1

# Worker serverless: segredo do Vercel Cron / agendador externo.
# O Vercel envia "Authorization: Bearer $CRON_SECRET" automaticamente.
CRON_SECRET=um-token-aleatorio-longo

# Segurança do dashboard (rotas de escrita). Sem isso, rotas abertas.
ADMIN_PASSWORD=uma-senha-forte

# Rate limit do cadastro por IP (padrão: 10 por minuto) — persistido no banco.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
